---
import { getCollection, render } from 'astro:content';

interface Props {
  locale?: 'en' | 'id';
}

const { locale = 'en' } = Astro.props;

// Get about content for the specified locale
const aboutEntries = await getCollection('about');
const about = aboutEntries.find(e =>
  locale === 'en' ? e.id.endsWith('en') : e.id.endsWith('id')
) || aboutEntries[0];

// Render the markdown content
const { Content } = await render(about);

// Extract paragraphs from the rendered content
// The markdown body contains multiple paragraphs
const bodyText = about.body;
const paragraphs = bodyText
  .split('\n\n')
  .filter(p => p.trim().length > 0);

const stats = about.data.stats || [];
---

<div class="about-body">
  {paragraphs.map((paragraph) => (
    <p class="about-text">{paragraph.trim()}</p>
  ))}

  {stats.length > 0 && (
    <div class="stats-row">
      {stats.map((stat, index) => (
        <div class="stat">
          <span class="stat-num">{stat.value}</span>
          <span class="stat-label">{stat.label.toUpperCase()}</span>
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .about-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about-text {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.72;
    color: var(--text-sub);
    max-width: 560px;
    margin: 0;
  }

  .stats-row {
    display: flex;
    align-items: stretch;
    margin-top: 8px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0 24px;
  }

  .stat:first-child {
    padding-left: 0;
  }

  .stat:not(:first-child) {
    border-left: 1px solid var(--border-mid);
  }

  .stat-num {
    font-size: 28px;
    font-weight: 900;
    color: var(--text);
    line-height: 1;
  }

  .stat-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
