---
interface Props {
  locale?: 'en' | 'id';
}
const { locale = 'en' } = Astro.props;

const t = {
  en: {
    eyebrow: 'SOFTWARE ENGINEER',
    tagline: 'Building reliable systems and clean interfaces.',
    viewWork: 'View Work',
    readBlog: 'Read Blog',
    available: 'Available for work',
    stack: 'TypeScript · Go · React',
  },
  id: {
    eyebrow: 'SOFTWARE ENGINEER',
    tagline: 'Membangun sistem yang andal dan antarmuka yang bersih.',
    viewWork: 'Lihat Proyek',
    readBlog: 'Baca Blog',
    available: 'Tersedia untuk pekerjaan',
    stack: 'TypeScript · Go · React',
  },
}[locale];
---

<div class="hero wrap">
  <div class="eyebrow-row">
    <span class="eyebrow">{t.eyebrow}</span>
    <span class="eyebrow-rule" aria-hidden="true"></span>
  </div>
  <h1>
    <span class="name-line">Muhammad</span>
    <span class="name-line rapi">Rapi.</span>
  </h1>
  <p class="tagline">{t.tagline}</p>
  <div class="cta-row">
    <a href="#projects" class="btn-primary">{t.viewWork}</a>
    <a href="#writing" class="btn-ghost">{t.readBlog}</a>
  </div>
  <div class="status-row">
    <span class="status-dot" aria-hidden="true"></span>
    <span class="status-text">{t.available}</span>
    <span class="status-sep" aria-hidden="true">·</span>
    <span class="status-stack">{t.stack}</span>
  </div>
</div>

<style>
  .hero {
    position: relative;
    padding-top: 80px;
    padding-bottom: 72px;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }

  .eyebrow-row,
  h1,
  .tagline,
  .cta-row,
  .status-row {
    position: relative;
    z-index: 1;
  }

  .eyebrow-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 4px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .eyebrow-rule {
    flex: 1;
    height: 1px;
    background: var(--border-mid);
  }

  h1 {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
  }

  .name-line {
    font-size: clamp(52px, 13vw, 88px);
    font-weight: 900;
    letter-spacing: -4px;
    line-height: 0.92;
    color: var(--text);
  }

  .rapi {
    border-bottom: 4px solid var(--text);
    display: inline-block;
    padding-bottom: 2px;
    margin-bottom: 4px;
  }

  .tagline {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.1px;
    line-height: 1.55;
    color: var(--text-sub);
    max-width: 440px;
    margin-bottom: 28px;
  }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }

  .btn-primary {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.3px;
    color: var(--bg);
    background: var(--text);
    border: var(--brut-border);
    border-radius: 4px;
    padding: 10px 22px;
    box-shadow: var(--brut-shadow);
    text-decoration: none;
    transition: transform 0.1s, box-shadow 0.1s;
    display: inline-block;
  }

  .btn-primary:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px var(--brut-fg);
  }

  .btn-primary:active {
    transform: translate(3px, 3px);
    box-shadow: none;
  }

  .btn-ghost {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-sub);
    background: none;
    border: none;
    border-bottom: 1px solid var(--border-mid);
    padding: 2px 0;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }

  .btn-ghost:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .status-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    background: var(--green);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .status-text {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-sub);
  }

  .status-sep {
    color: var(--text-muted);
    font-size: 12px;
  }

  .status-stack {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
  }

  @media (max-width: 480px) {
    .hero {
      padding-top: 56px;
    }
    .name-line {
      letter-spacing: -2px;
    }
  }
</style>
