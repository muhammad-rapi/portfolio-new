---
import fs from 'fs';
import path from 'path';

interface Props {
  locale?: 'en' | 'id';
}

const { locale = 'en' } = Astro.props;

// Load experience data from JSON
const experiencePath = path.join(process.cwd(), 'src', 'content', 'experience.json');
const experienceData = JSON.parse(fs.readFileSync(experiencePath, 'utf-8'));

const experiences = experienceData.map((exp: any, index: number) => ({
  ...exp,
  order: exp.order ?? index,
}));

// Sort by order
experiences.sort((a: any, b: any) => a.order - b.order);
---

<div class="timeline">
  {experiences.map((exp: any, i: number) => (
    <div class={`exp-row${i === experiences.length - 1 ? ' last' : ''}`}>
      <span class="period">{exp.period}</span>
      <div class="content">
        <span class="company">{exp.company}</span>
        <span class="role">{exp.role}</span>
        {exp.description && <p class="exp-note">{exp.description}</p>}
      </div>
    </div>
  ))}
</div>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
  }

  .exp-row {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
  }

  .exp-row.last {
    border-bottom: none;
  }

  .period {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--text-muted);
    text-transform: uppercase;
    padding-top: 2px;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .company {
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.2px;
  }

  .role {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-sub);
  }

  .exp-note {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text-muted);
    margin-top: 2px;
    margin: 0;
    padding: 0;
  }
</style>
