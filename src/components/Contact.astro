---
interface Props {
  locale?: 'en' | 'id';
}
const { locale = 'en' } = Astro.props;

const t = {
  en: {
    email: 'Email',
    github: 'GitHub',
    linkedin: 'LinkedIn',
    orSend: 'OR SEND A MESSAGE',
    namePh: 'Your name',
    emailPh: 'Your email',
    subjectPh: 'Subject',
    messagePh: 'Your message',
    send: 'Send Message',
  },
  id: {
    email: 'Email',
    github: 'GitHub',
    linkedin: 'LinkedIn',
    orSend: 'ATAU KIRIM PESAN',
    namePh: 'Nama Anda',
    emailPh: 'Email Anda',
    subjectPh: 'Subjek',
    messagePh: 'Pesan Anda',
    send: 'Kirim Pesan',
  },
}[locale];
---

<div class="contact-wrap">
  <div class="social-row">
    <a href="mailto:hello@muhammadrapi.dev" class="social-btn">
      <i class="fa-solid fa-envelope"></i>
      <span>{t.email}</span>
    </a>
    <a href="https://github.com/muhammadrapi" target="_blank" rel="noopener" class="social-btn">
      <i class="fa-brands fa-github"></i>
      <span>{t.github}</span>
    </a>
    <a href="https://linkedin.com/in/muhammadrapi" target="_blank" rel="noopener" class="social-btn">
      <i class="fa-brands fa-linkedin"></i>
      <span>{t.linkedin}</span>
    </a>
  </div>

  <div class="divider">
    <span class="divider-rule"></span>
    <span class="divider-text">{t.orSend}</span>
    <span class="divider-rule"></span>
  </div>

  <form class="contact-form" onsubmit="return false;">
    <div class="form-row">
      <input type="text" class="form-input" placeholder={t.namePh} autocomplete="name" />
      <input type="email" class="form-input" placeholder={t.emailPh} autocomplete="email" />
    </div>
    <input type="text" class="form-input" placeholder={t.subjectPh} />
    <textarea class="form-input form-textarea" placeholder={t.messagePh} rows="4"></textarea>
    <button type="submit" class="btn-send">
      <i class="fa-solid fa-paper-plane"></i>
      {t.send}
    </button>
  </form>
</div>

<style>
  .contact-wrap {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .social-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--border-mid);
    border-radius: 4px;
    padding: 10px 16px;
    background: var(--bg-card);
    color: var(--text-sub);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: border-color 0.15s, color 0.15s;
  }

  .social-btn:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .divider-rule {
    flex: 1;
    height: 1px;
    background: var(--border-mid);
  }

  .divider-text {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 3px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .form-input {
    border: 1px solid var(--border-mid);
    border-radius: 3px;
    padding: 10px 12px;
    background: var(--bg-card);
    color: var(--text);
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 600;
    outline: none;
    transition: border-color 0.15s;
    width: 100%;
  }

  .form-input::placeholder {
    color: var(--text-muted);
    font-weight: 600;
  }

  .form-input:focus {
    border-color: var(--border-strong);
  }

  .form-textarea {
    min-height: 88px;
    resize: vertical;
  }

  .btn-send {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px;
    background: var(--text);
    color: var(--bg);
    border: var(--brut-border);
    border-radius: 4px;
    box-shadow: var(--brut-shadow);
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.1s, box-shadow 0.1s;
  }

  .btn-send:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px var(--brut-fg);
  }

  .btn-send:active {
    transform: translate(3px, 3px);
    box-shadow: none;
  }

  @media (max-width: 480px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
